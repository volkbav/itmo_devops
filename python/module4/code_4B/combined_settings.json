{
    "docker-compose": {
        "name": "task_manager_dev",
        "services": {
            "backend": {
                "volumes": [
                    "static:/static"
                ],
                "image": "volkbav/task_manager",
                "ports": [
                    "8000:8000"
                ],
                "restart": "always",
                "env_file": [
                    ".env"
                ],
                "depends_on": {
                    "db": {
                        "condition": "service_healthy"
                    }
                },
                "command": "sh -c \" uv run python manage.py migrate && uv run python manage.py collectstatic --noinput && uv run gunicorn --workers=4 --bind 0.0.0.0:8000 task_manager.wsgi:application \"\n",
                "security_opt": [
                    "no-new-privileges:true"
                ],
                "cap_drop": [
                    "ALL"
                ],
                "healthcheck": {
                    "test": [
                        "CMD",
                        "python",
                        "-c",
                        "import urllib.request; urllib.request.urlopen('http://localhost:8000')"
                    ],
                    "interval": "30s",
                    "timeout": "10s",
                    "retries": 5,
                    "start_period": "60s"
                }
            },
            "db": {
                "image": "postgres:16.3",
                "restart": "always",
                "shm_size": "128mb",
                "env_file": [
                    ".env"
                ],
                "volumes": [
                    "pgdata:/var/lib/postgresql/data"
                ],
                "healthcheck": {
                    "test": [
                        "CMD-SHELL",
                        "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"
                    ],
                    "interval": "5s",
                    "timeout": "5s",
                    "retries": 5
                }
            },
            "adminer": {
                "image": "adminer",
                "restart": "always",
                "ports": [
                    "8080:8080"
                ]
            }
        },
        "volumes": {
            "pgdata": null,
            "static": null
        }
    },
    "docker-compose1": {
        "name": "my_file_for_docker",
        "services": {
            "nginx": {
                "build": "./nginx",
                "restart": "always",
                "ports": [
                    "80:80",
                    "443:443"
                ],
                "volumes": [
                    "./certbot/certbot_www:/var/www/certbot",
                    "./certbot/certbot_etc:/etc/letsencrypt",
                    "static:/static",
                    "./nginx/default.conf:/etc/nginx/conf.d/default.conf"
                ],
                "depends_on": [
                    "backend"
                ]
            },
            "backend": {
                "volumes": [
                    "static:/static"
                ],
                "image": "volkbav/task_manager",
                "restart": "always",
                "env_file": [
                    ".env"
                ],
                "depends_on": {
                    "db": {
                        "condition": "service_healthy"
                    }
                },
                "command": "sh -c \" uv run python manage.py migrate && uv run python manage.py collectstatic --noinput && uv run gunicorn --workers=4 --bind 0.0.0.0:8000 task_manager.wsgi:application \"\n",
                "security_opt": [
                    "no-new-privileges:true"
                ],
                "cap_drop": [
                    "ALL"
                ]
            },
            "db": {
                "image": "postgres:16.3",
                "restart": "always",
                "shm_size": "128mb",
                "env_file": [
                    ".env"
                ],
                "volumes": [
                    "pgdata:/var/lib/postgresql/data"
                ],
                "healthcheck": {
                    "test": [
                        "CMD-SHELL",
                        "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"
                    ],
                    "interval": "5s",
                    "timeout": "5s",
                    "retries": 5
                }
            },
            "certbot": {
                "image": "certbot/certbot",
                "restart": "no",
                "volumes": [
                    "./certbot/certbot_www:/var/www/certbot",
                    "./certbot/certbot_etc:/etc/letsencrypt"
                ],
                "command": "certonly --webroot --webroot-path=/var/www/certbot --email example@example.com --agree-tos --no-eff-email -d example.com -d www.example.com\n",
                "depends_on": [
                    "nginx"
                ]
            }
        },
        "volumes": {
            "pgdata": null,
            "static": null
        }
    }
}