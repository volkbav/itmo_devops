#node-exporter
docker run -d \
      --restart=always \
      --name node-exporter \
      -p 9100:9100 \
      quay.io/prometheus/node-exporter:latest

#victoriametrics
docker run -d \
      --restart=always \
      --name victoria-metrics \
      -p 8428:8428 \
      -v ./prometheus.yml:/etc/victoriametrics/prometheus.yml \
      victoriametrics/victoria-metrics:latest \
      -promscrape.config=/etc/victoriametrics/prometheus.yml

#prometheus.yml
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets: ['http://192.168.23.3:9100'] # Example target

